# ==============================================================================
# LANDINTEL / DIASPORALAND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (SQLite for local dev, PostgreSQL/CockroachDB for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/landintel?schema=public&sslmode=prefer"

# Authentication & Security
JWT_SECRET="generate-a-secure-random-64-character-secret-key"
SESSION_EXPIRY_DAYS="7"
CSRF_SECRET="secure-random-token-for-csrf-protection"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (Local filesystem or S3/GCS compliant object storage)
STORAGE_PROVIDER="local" # "local" | "s3" | "gcs"
STORAGE_LOCAL_PATH="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="landintel-secure-documents"

# Payment Gateways (Multi-provider abstraction: Paystack, Flutterwave, Stripe)
DEFAULT_PAYMENT_PROVIDER="paystack" # "paystack" | "flutterwave" | "stripe"
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"
PAYSTACK_WEBHOOK_SECRET="whsec_placeholder"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-placeholder"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# AI & LLM Providers (Multi-provider ledger: Gemini, OpenAI, Anthropic)
DEFAULT_AI_PROVIDER="gemini" # "gemini" | "openai" | "anthropic"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# OCR & Vision Extraction Providers
OCR_PROVIDER="tesseract" # "tesseract" | "google_vision" | "aws_textract"
GOOGLE_APPLICATION_CREDENTIALS_JSON=""

# External Geospatial & Mapping Providers (Satellite, Cadastral, Zoning)
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""
OPEN_ELEVATION_API_URL="https://api.open-elevation.com/api/v1/lookup"

# Currency Exchange Rate Provider
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_BASE_URL="https://api.exchangerate.host/latest"

# Email & Transactional Notifications (Resend, SendGrid, or SMTP)
EMAIL_PROVIDER="resend" # "console" | "resend" | "sendgrid" | "smtp"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="LandIntel <notifications@landintel.ai>"
BRAND_EMAIL="support@landintel.ai"
SUPPORT_DISPLAY_EMAIL="support@landintel.ai"
ADMIN_EMAIL="admin@landintel.ai"

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
GOOGLE_RECAPTCHA_API_KEY=""

# Monitoring, Error Tracking & Telemetry
SENTRY_DSN=""
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"

