datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          String         @default("FREE") // FREE, PAID, ADMIN, SUPER_ADMIN
  isVerified    Boolean        @default(false)
  verificationToken String?
  resetToken    String?
  resetExpires  DateTime?
  preferredLanguage String     @default("en")
  preferredCurrency String     @default("NGN")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions      Session[]
  memberships   Membership[]
  propertyCases PropertyCase[]
  reports       PropertyReport[]
  payments      Payment[]
  auditLogs     AuditLog[]
  aiUsages      AIUsage[]
  creditLedgers AICreditLedger[]
  notifications Notification[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  country         String           @default("Nigeria")
  defaultCurrency String           @default("NGN")
  defaultLanguage String           @default("en")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  memberships     Membership[]
  subscriptions   Subscription[]
  usageRecords    UsageRecord[]
  creditLedgers   AICreditLedger[]
  propertyCases   PropertyCase[]
  notifications   Notification[]

  @@index([slug])
}

model Membership {
  id              String         @id @default(cuid())
  organizationId  String
  userId          String
  role            String         @default("MEMBER") // OWNER, ADMIN, ANALYST, VIEWER, MEMBER
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Subscription {
  id                    String         @id @default(cuid())
  organizationId        String
  planId                String
  status                String         @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED, EXPIRED, PAUSED, PAYMENT_FAILED, GRACE_PERIOD
  provider              String         @default("SANDBOX") // PAYSTACK, STRIPE, FLUTTERWAVE, SANDBOX
  providerSubId         String?
  currentPeriodStart    DateTime       @default(now())
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                  Plan           @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model Plan {
  id          String         @id @default(cuid())
  key         String?        @unique // FREE, STARTER, PROFESSIONAL, BUSINESS, ENTERPRISE
  name        String         @unique // FREE, PAID_REPORT, PRO_INVESTOR, etc.
  priceNgn    Float
  priceUsd    Float          @default(0)
  caseLimit   Int
  docLimit    Int
  aiAllowance Int
  features    String?        // JSON string of entitlement keys
  createdAt   DateTime       @default(now())

  subscriptions Subscription[]
}

model UsageRecord {
  id                    String         @id @default(cuid())
  organizationId        String
  period                String         // YYYY-MM
  casesCreated          Int            @default(0)
  documentsUploaded     Int            @default(0)
  storageBytes          Int            @default(0)
  ocrOperations         Int            @default(0)
  aiTokensUsed          Int            @default(0)
  reportsGenerated      Int            @default(0)
  exportsCount          Int            @default(0)
  externalVerifications Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
}

model AICreditLedger {
  id              String         @id @default(cuid())
  organizationId  String?
  userId          String
  caseId          String?
  documentId      String?
  operation       String         // OCR, CLASSIFICATION, EXTRACTION, RECONCILIATION, ASSISTANT, REPORT_SUMMARY
  provider        String         // GEMINI, OPENAI, ANTHROPIC, HEURISTIC
  model           String
  tokensUsed      Int            @default(0)
  creditsConsumed Float          @default(1.0)
  estimatedCost   Float          @default(0.0)
  currency        String         @default("USD")
  createdAt       DateTime       @default(now())

  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([operation])
}

model PropertyCase {
  id            String             @id @default(cuid())
  userId        String
  organizationId String?
  title         String
  country       String             @default("Nigeria")
  countryCode   String             @default("NG")
  state         String
  lga           String
  address       String
  propertyType  String             // LAND, RESIDENTIAL, COMMERCIAL, AGRICULTURAL, MIXED_USE, OTHER
  purchasePrice Float?
  currency      String             @default("NGN")
  sellerName    String?
  agentName     String?
  latitude      Float?
  longitude     Float?
  description   String?
  status        String             @default("DRAFT") // DRAFT, UPLOADING, ANALYZING, ANALYSIS_COMPLETE, NEEDS_REVIEW, REPORT_GENERATED, COMPLETED, ERROR
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents     PropertyDocument[]
  extractions   DocumentExtraction[]
  findings      PropertyFinding[]
  riskScore     RiskScore?
  verificationItems VerificationItem[]
  reports       PropertyReport[]
  payments      Payment[]
  aiUsages      AIUsage[]
  parties       PropertyParty[]
  geometries    PropertyGeometry[]
  externalVerifications ExternalVerification[]
  backgroundJobs BackgroundJob[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model PropertyParty {
  id           String       @id @default(cuid())
  caseId       String
  name         String
  role         String       // ASSIGNOR, ASSIGNEE, VENDOR, PURCHASER, SURVEYOR, WITNESS, MORTGAGEE, OTHER
  documentId   String?
  verified     Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now())

  propertyCase PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([role])
}

model PropertyGeometry {
  id                  String       @id @default(cuid())
  caseId              String
  coordinateSystem    String       @default("WGS84") // WGS84, MINNA_UTM31N, CLARKE1880, EPSG_3857
  coordinatesJson     String       // JSON array of [longitude, latitude] or [x, y]
  calculatedAreaSqm   Float?
  calculatedPerimeterM Float?
  polygonStatus       String       @default("VALID") // VALID, SELF_INTERSECTING, INCOMPLETE, RECTILINEAR
  warnings            String?      // JSON array of warnings
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  propertyCase        PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model ExternalVerification {
  id                 String       @id @default(cuid())
  caseId             String
  provider           String       // LANDS_BUREAU, CADASTRAL_AGENCY, PLANNING_DEPT, TAX_AUTHORITY, SURCON, HMLR, ARDHISASA
  jurisdictionCode   String       @default("NG")
  recordReference    String
  verificationMethod String       // API, REGISTRY_SEARCH, MANUAL_INQUIRY, CADASTRAL_CHARTING
  status             String       @default("NOT_AVAILABLE") // VERIFIED, PARTIALLY_VERIFIED, CONSISTENT, INCONSISTENT, NOT_FOUND, NOT_AVAILABLE, NOT_SUPPORTED, USER_PROVIDED_ONLY, REQUIRES_HUMAN_VERIFICATION
  limitations        String?
  responseDetails    String?      // JSON response
  checkedAt          DateTime     @default(now())

  propertyCase       PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([provider])
  @@index([status])
}

model BackgroundJob {
  id           String       @id @default(cuid())
  caseId       String?
  jobType      String       // OCR, CLASSIFICATION, RECONCILIATION, RISK_ANALYSIS, GEOSPATIAL, EXTERNAL_VERIFY, REPORT_GEN, NOTIFICATION
  status       String       @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, RETRYING, CANCELLED
  payload      String?      // JSON payload
  result       String?      // JSON result
  attempts     Int          @default(0)
  maxAttempts  Int          @default(3)
  error        String?
  lockedAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  propertyCase PropertyCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([jobType])
  @@index([caseId])
}

model Notification {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  title          String
  message        String
  type           String        @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead         Boolean       @default(false)
  link           String?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
}

model CurrencyRate {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 4217 code (NGN, USD, EUR, GBP, etc.)
  rateToNgn Float
  rateToUsd Float
  source    String   @default("SYSTEM_REGISTRY")
  updatedAt DateTime @updatedAt
}

model PropertyDocument {
  id               String               @id @default(cuid())
  caseId           String
  originalName     String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  category         String               @default("UNKNOWN") // SURVEY_PLAN, DEED_OF_ASSIGNMENT, CERTIFICATE_OF_OCCUPANCY, etc.
  processingStatus String               @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  pageCount        Int                  @default(1)
  ocrText          String?
  extractedSummary String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  propertyCase     PropertyCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  pages            DocumentPage[]
  extractions      DocumentExtraction[]
  entities         DocumentEntity[]

  @@index([caseId])
  @@index([category])
}

model DocumentPage {
  id         String           @id @default(cuid())
  documentId String
  pageNumber Int
  rawText    String?
  confidence Float            @default(1.0)
  createdAt  DateTime         @default(now())

  document   PropertyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentExtraction {
  id            String           @id @default(cuid())
  documentId    String
  caseId        String
  fieldName     String           // plot_number, parcel_number, surveyor_name, boundary_description, etc.
  fieldValue    String
  pageNumber    Int              @default(1)
  confidence    Float            @default(0.95)
  sourceSnippet String?
  createdAt     DateTime         @default(now())

  document      PropertyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  propertyCase  PropertyCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([documentId])
  @@index([fieldName])
}

model DocumentEntity {
  id          String           @id @default(cuid())
  documentId  String
  entityType  String           // PERSON, ORGANIZATION, PARCEL, SURVEY_NO, DATE, AUTHORITY
  entityValue String
  createdAt   DateTime         @default(now())

  document    PropertyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([entityType])
}

model PropertyFinding {
  id                String       @id @default(cuid())
  caseId            String
  title             String
  severity          String       // LOW, MODERATE, ELEVATED, HIGH, CRITICAL
  category          String       // DOCUMENTATION, OWNERSHIP, GEOGRAPHIC, CONSISTENCY, COMPLETENESS, TRANSACTION
  description       String
  evidenceSummary   String
  sourceDocIds      String?      // JSON array of document IDs
  pageReferences    String?      // e.g. "Survey Plan (Page 2), Deed of Assignment (Page 1)"
  whyItMatters      String
  recommendedAction String
  isPremiumLocked   Boolean      @default(false)
  createdAt         DateTime     @default(now())

  propertyCase      PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([severity])
  @@index([category])
}

model RiskScore {
  id                 String       @id @default(cuid())
  caseId             String       @unique
  score              Int          // 0 to 100
  level              String       // LOW, MODERATE, ELEVATED, HIGH, CRITICAL
  explanation        String
  documentationScore Int          @default(0)
  ownershipScore     Int          @default(0)
  geographicScore    Int          @default(0)
  consistencyScore   Int          @default(0)
  updatedAt          DateTime     @updatedAt

  propertyCase       PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model VerificationItem {
  id                   String       @id @default(cuid())
  caseId               String
  itemKey              String
  title                String
  description          String
  status               String       @default("PENDING") // PENDING, COMPLETE, NEEDS_REVIEW, NOT_APPLICABLE
  notes                String?
  requiresProfessional Boolean      @default(false)
  updatedAt            DateTime     @updatedAt

  propertyCase         PropertyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([itemKey])
}

model PropertyReport {
  id            String          @id @default(cuid())
  caseId        String
  userId        String
  reportVersion Int             @default(1)
  status        String          @default("READY") // DRAFT, READY, ARCHIVED
  summary       String?
  isPaidUnlocked Boolean        @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  propertyCase  PropertyCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      ReportVersion[]
  payments      Payment[]

  @@index([caseId])
  @@index([userId])
}

model ReportVersion {
  id              String         @id @default(cuid())
  reportId        String
  versionNumber   Int
  generatedPdfKey String?
  checksum        String?
  createdAt       DateTime       @default(now())

  report          PropertyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Payment {
  id            String          @id @default(cuid())
  userId        String
  caseId        String?
  reportId      String?
  amount        Float
  currency      String          @default("NGN")
  reference     String          @unique
  provider      String          @default("PAYSTACK") // PAYSTACK, STRIPE, FLUTTERWAVE, SANDBOX
  status        String          @default("PENDING") // PENDING, SUCCESSFUL, FAILED, REFUNDED
  verifiedAt    DateTime?
  metadata      String?         // JSON string
  createdAt     DateTime        @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyCase  PropertyCase?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  report        PropertyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([reference])
  @@index([status])
}

model AIUsage {
  id          String        @id @default(cuid())
  userId      String
  caseId      String?
  taskType    String        // CLASSIFICATION, EXTRACTION, COMPARISON, ASSISTANT, REPORT_SUMMARY
  provider    String        // GEMINI, OPENAI, ANTHROPIC, HEURISTIC
  model       String
  tokensUsed  Int           @default(0)
  latencyMs   Int           @default(0)
  status      String        @default("SUCCESS")
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyCase PropertyCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([taskType])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String   // USER_REGISTER, USER_LOGIN, CASE_CREATE, DOC_UPLOAD, PAYMENT_SUCCESS, REPORT_DOWNLOAD, etc.
  resourceType String?  // User, PropertyCase, PropertyDocument, Payment, Report
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  details      String?  // JSON string
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
