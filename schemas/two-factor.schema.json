{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landintel.ng/schemas/two-factor.schema.json",
  "title": "TwoFactorVerifyRequest",
  "type": "object",
  "required": ["code"],
  "properties": {
    "challengeId": { "type": "string", "format": "uuid" },
    "code": { "type": "string", "pattern": "^[0-9]{6}$" }
  }
}
