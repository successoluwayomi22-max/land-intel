{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landintel.ng/schemas/case.schema.json",
  "title": "PropertyCase",
  "type": "object",
  "required": ["id", "reference", "name", "status", "countryCode", "propertyType", "createdAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "string", "format": "uuid" },
    "createdBy": { "type": "string", "format": "uuid" },
    "reference": { "type": "string", "pattern": "^DL-[0-9]{4}-[0-9]{6}$" },
    "name": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "UPLOADING",
        "PROCESSING",
        "ANALYZING",
        "PARTIALLY_ANALYZED",
        "ANALYZED",
        "REQUIRES_REVIEW",
        "REPORT_READY",
        "ARCHIVED",
        "FAILED"
      ]
    },
    "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "countryCode": { "type": "string" },
        "regionCode": { "type": "string" },
        "districtCode": { "type": "string" },
        "city": { "type": "string" }
      }
    },
    "propertyType": {
      "type": "string",
      "enum": ["LAND", "RESIDENTIAL", "COMMERCIAL", "AGRICULTURAL", "MIXED_USE", "OTHER"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
