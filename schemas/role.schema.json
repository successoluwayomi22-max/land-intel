  "$id": "https://landintel.ng/schemas/role.schema.json",
  "title": "Role",
  "type": "object",
  "required": ["id", "name", "description", "permissions"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "permissions": {
