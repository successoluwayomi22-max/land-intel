{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landintel.ng/schemas/notification.schema.json",
  "title": "Notification",
  "type": "object",
  "required": ["id", "userId", "type", "title", "message", "severity", "read", "createdAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "organizationId": { "type": ["string", "null"], "format": "uuid" },
    "type": {
      "type": "string",
      "enum": [
        "WELCOME",
        "EMAIL_VERIFIED",
        "SECURITY",
        "DOCUMENT",
        "ANALYSIS",
        "REPORT",
        "PAYMENT",
        "BILLING",
        "SUPPORT",
        "SYSTEM",
        "ANNOUNCEMENT",
        "ACCOUNT"
      ]
    },
    "title": { "type": "string" },
    "message": { "type": "string" },
    "severity": { "type": "string", "enum": ["INFO", "SUCCESS", "WARNING", "CRITICAL"] },
    "read": { "type": "boolean", "default": false },
    "readAt": { "type": ["string", "null"], "format": "date-time" },
    "actionUrl": { "type": ["string", "null"] },
    "metadata": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
